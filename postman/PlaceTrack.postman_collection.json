              "host": [
                "{{eligUrl}}"
              ],
              "path": [
                "eligibility",
                "check"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cgpa\": 7.9,\n  \"backlogs\": 0,\n  \"department\": \"MECH\",\n  \"minCgpa\": 7.5,\n  \"maxBacklogs\": 0,\n  \"allowedDepartments\": [\n    \"IT\",\n    \"CSE\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Department reason\", () => pm.expect(pm.response.json().reasons[0]).to.include(\"Department MECH\"));"
                ]
              }
            }
          ]
        },
        {
